# Wzór konfiguracji. Skopiuj do .env i uzupełnij.
# OPENROUTER_API_KEY jest dziedziczony z /opt/data/.env, nie trzeba go tu powtarzać.

# Kalendarz, do którego agent zapisuje wizyty. Utwórz go: python -m agent.setup_demo_calendar
VOICE_CALENDAR_ID=

# Model LLM. Mały i szybki — telefonia nie znosi opóźnień (zmierzone 0,4-0,9 s z narzędziem).
VOICE_LLM_MODEL=google/gemini-3.1-flash-lite

# --- Warstwa mowy (etap 2) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

# --- Telefonia (etap 2) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Publiczny adres WebSocketu z TLS — Twilio wymaga wss://
PUBLIC_WSS_URL=wss://voice.jnxautomation.pl/ws
# Numer, który będzie na stronie portfolio
VOICE_PORTFOLIO_NUMBER="+48 XXX XXX XXX"
# Prywatny numer Jana — z niego agent czyta status dnia zamiast prowadzić recepcję (etap 5)
VOICE_OWNER_PHONE=

# --- Powiadomienia (etap 3) ---
N8N_LEAD_WEBHOOK=
